{
  "name": "@zolexora/appsuite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @zolexora/appsuite-client dev",
    "dev:infisical": "pnpm --filter @zolexora/appsuite-client dev:infisical",
    "dev:client": "pnpm --filter @zolexora/appsuite-client dev",
    "dev:client:infisical": "pnpm --filter @zolexora/appsuite-client dev:infisical",
    "dev:team": "pnpm --filter @zolexora/appsuite-dev-team dev",
    "dev:team:infisical": "pnpm --filter @zolexora/appsuite-dev-team dev:infisical",
    "dev:api": "pnpm --filter @zolexora/appsuite-backend dev",
    "dev:api:infisical": "pnpm --filter @zolexora/appsuite-backend dev:infisical",
    "build": "pnpm --filter @zolexora/appsuite-client build && pnpm --filter @zolexora/appsuite-dev-team build && pnpm --filter @zolexora/appsuite-backend build",
    "start": "pnpm --filter @zolexora/appsuite-client start",
    "lint": "pnpm --filter @zolexora/appsuite-client lint && pnpm --filter @zolexora/appsuite-dev-team lint",
    "type-check": "pnpm --filter @zolexora/appsuite-client type-check && pnpm --filter @zolexora/appsuite-dev-team type-check && pnpm --filter @zolexora/appsuite-backend type-check"
  }
}
