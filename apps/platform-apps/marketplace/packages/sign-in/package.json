{
  "name": "@zolexora/shop-sign-in",
  "version": "0.1.0",
  "private": true,
  "description": "Marketplace sign-in screens on the Zolexora auth service (Track 1 buyers/sellers, Track 3 admins)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@zolexora/auth-client": "workspace:*"
  },
  "peerDependencies": {
    "firebase": ">=11",
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "firebase": "^12.17.1",
    "react": "19.1.0",
    "tsup": "^8.4.0",
    "typescript": "^5.4.5"
  }
}
