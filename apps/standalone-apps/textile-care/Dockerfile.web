ARG APP_PATH=apps/marketplace-web
FROM node:25-alpine AS builder
ARG APP_PATH
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages ./packages
COPY apps/standalone-apps/textile-care ./apps/standalone-apps/textile-care

RUN corepack enable && corepack prepare pnpm@9 --activate
RUN ln -s /app/packages /packages
RUN pnpm config set ignore-scripts true && pnpm install --no-frozen-lockfile
RUN pnpm --filter "./apps/standalone-apps/textile-care/${APP_PATH}" build

FROM node:25-alpine
WORKDIR /app
ARG APP_PATH
ENV APP_PATH=${APP_PATH}
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
ENV NODE_ENV=production

COPY --from=builder /app/apps/standalone-apps/textile-care/${APP_PATH}/.next/standalone ./
COPY --from=builder /app/apps/standalone-apps/textile-care/${APP_PATH}/.next/static ./apps/standalone-apps/textile-care/${APP_PATH}/.next/static
COPY --from=builder /app/apps/standalone-apps/textile-care/${APP_PATH}/public ./apps/standalone-apps/textile-care/${APP_PATH}/public

EXPOSE 3000

CMD ["sh", "-c", "node $(find . -maxdepth 5 -name server.js | grep -v node_modules | head -n 1)"]
