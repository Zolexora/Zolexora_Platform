{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.zolexora.example/erp/v1/event-envelope.schema.json",
  "title": "Integration event envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "event_type", "occurred_at", "source_system", "source_tenant_id", "organization_external_id", "correlation_id", "idempotency_key", "payload"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"type": "string", "minLength": 1, "maxLength": 100},
    "occurred_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "source_system": {"type": "string", "minLength": 1},
    "source_tenant_id": {"type": "string", "minLength": 1},
    "organization_external_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "causation_id": {"type": ["string", "null"]},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 200},
    "payload": {"type": "object"}
  }
}
