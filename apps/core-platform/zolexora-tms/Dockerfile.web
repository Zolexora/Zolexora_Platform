ARG APP_PATH=apps/tms-web
FROM node:25-alpine AS builder
ARG APP_PATH
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.12.3 --activate

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages ./packages
COPY apps/core-platform/zolexora-tms ./apps/core-platform/zolexora-tms

RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm config set store-dir /root/.local/share/pnpm/store && \
    pnpm config set ignore-scripts true && \
    pnpm install --frozen-lockfile

# Builds the app and every workspace package it depends on (auth-client, utils, ...)
RUN pnpm --filter "{./apps/core-platform/zolexora-tms/${APP_PATH}}..." build

FROM nginx:alpine
ARG APP_PATH
COPY apps/core-platform/zolexora-tms/nginx-web.conf /etc/nginx/conf.d/default.conf
COPY apps/core-platform/zolexora-tms/docker-entrypoint-env.sh /docker-entrypoint.d/40-env-config.sh
RUN chmod +x /docker-entrypoint.d/40-env-config.sh
COPY --from=builder /app/apps/core-platform/zolexora-tms/${APP_PATH}/dist /usr/share/nginx/html
EXPOSE 80
