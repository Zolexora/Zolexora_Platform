# ==============================================================================
# ZOLEXORA PLATFORM ADMIN — ENVIRONMENT CONFIGURATION
# Copy this file to .env in apps/platform-admin to supply credentials.
# Local PostgreSQL is NOT tracked. Telemetry monitors cloud Supabase & MongoDB.
# ==============================================================================

# Option 1: Infisical Cloud Machine Identity or Service Token (Recommended)
INFISICAL_TOKEN=
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_WORKSPACE_ID=
INFISICAL_SITE_URL=https://app.infisical.com
ENVIRONMENT=dev

# Option 2: Direct Cloud Database URLs (Fallback / Overrides)
# Supabase PostgreSQL Cloud Clusters (500MB Free Tier per cluster)
SUPABASE_CORE_URL=
SUPABASE_CORE_SERVICE_KEY=
SUPABASE_CORE_PG_URL=postgresql://postgres.xxx:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

SUPABASE_COMMERCE_URL=
SUPABASE_COMMERCE_SERVICE_KEY=
SUPABASE_COMMERCE_PG_URL=postgresql://postgres.xxx:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

SUPABASE_BUSINESS_URL=
SUPABASE_BUSINESS_SERVICE_KEY=
SUPABASE_BUSINESS_PG_URL=postgresql://postgres.xxx:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

SUPABASE_AI_ERP_URL=
SUPABASE_AI_ERP_SERVICE_KEY=
SUPABASE_AI_ERP_PG_URL=postgresql://postgres.xxx:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# MongoDB Atlas Shared Cluster (512MB Free Tier)
MONGO_URI=mongodb+srv://user:pass@cluster0.mongodb.net/?retryWrites=true&w=majority

# Cloudflare & Email Gateways
CF_ACCOUNT_ID=
RESEND_API_KEY=
