# Zolexora ERP environment template
# Copy this file to .env and update values before starting services.

# Site configuration
SITE_NAME=site1.example.com
ADMIN_PASSWORD=ChangeMe123!
SITE_OWNER=Administrator
DB_ROOT_USER=root
MYSQL_ROOT_PASSWORD=ChangeMe123!
MYSQL_USER=frappe
MYSQL_PASSWORD=frappe
MYSQL_DATABASE=frappe

# Redis configuration
REDIS_CACHE=redis-cache:6379
REDIS_QUEUE=redis-queue:6379
REDIS_SOCKETIO=redis-socketio:6379

# Ports
FRAPPE_PORT=8000
HTTP_PORT=8080
HTTPS_PORT=8443

# Application settings
TIMEZONE=UTC
DEFAULT_LANGUAGE=en
LANGUAGE=English
USER_EMAIL=admin@example.com

# Payments
# Set INSTALL_PAYMENTS=1 to enable Frappe Payments app installation on main certification path.
# Set INSTALL_PAYMENTS=0 to omit Payments app during clean bootstrap.
# Zolexora-specific payment gateway logic must live in zolexora_integrations, not in Payments core.
INSTALL_PAYMENTS=0

# Email / SMTP
MAIL_SERVER=your_smtp_host
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_LOGIN=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_FROM_ADDRESS=erp@zolexora.com

# Security settings
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://localhost:8000
COOKIE_SECURE=0
ENABLE_HTTPS=0
BACKUP_RETENTION_DAYS=30

# Cloudflare / Northflank placeholders
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
NORTHFLANK_PROJECT_ID=your_northflank_project_id
NORTHFLANK_SERVICE_NAME=zolexora-erp

# Worker settings
WORKER_SHORT_QUEUE=short
WORKER_LONG_QUEUE=long
WORKER_DEFAULT_QUEUE=default
