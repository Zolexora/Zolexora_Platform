{
  "name": "Zolexora Platform Devcontainer",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": true,
      "enableNonRootDocker": "true"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20",
      "pnpmVersion": "latest",
      "yarnVersion": "latest"
    },
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17",
      "installMaven": "false",
      "installGradle": "false"
    }
  },
  "forwardPorts": [
    3000, 3001, 3002, 3003,
    3070, 3071, 3072, 3075, 3076, 3077, 3079, 3080, 3081, 3082, 3083, 3084,
    3085, 3086, 3087, 3088, 3089,
    4010, 4030, 4090, 4100, 4110, 4120,
    8000, 8001, 8080, 8443,
    5433, 5434, 5435, 5436, 5437, 5438, 5439, 5440,
    5441, 5442, 5443, 5444, 5445, 5448,
    6379, 27017,
    54321, 54322, 54323, 54324
  ],
  "portsAttributes": {
    "3000": { "label": "Next.js / Frontend Dev", "onAutoForward": "notify" },
    "3001": { "label": "Next.js App 2", "onAutoForward": "silent" },
    "3002": { "label": "Next.js App 3", "onAutoForward": "silent" },
    "3003": { "label": "Next.js App 4", "onAutoForward": "silent" },
    "3070": { "label": "Zolexora AppSuite Gateway", "onAutoForward": "notify" },
    "3071": { "label": "Zolexora AI Gateway", "onAutoForward": "notify" },
    "3072": { "label": "Zolexora IMS Gateway", "onAutoForward": "notify" },
    "3075": { "label": "ClarityFi Gateway", "onAutoForward": "notify" },
    "3076": { "label": "Rentoeasy Gateway", "onAutoForward": "notify" },
    "3077": { "label": "Zolexora Engage Gateway", "onAutoForward": "notify" },
    "3079": { "label": "Zolexora Marketplace Gateway", "onAutoForward": "notify" },
    "3080": { "label": "The Textile Care Gateway", "onAutoForward": "notify" },
    "3081": { "label": "Platform Admin API", "onAutoForward": "silent" },
    "3082": { "label": "Platform Admin Web", "onAutoForward": "notify" },
    "3083": { "label": "Maun Kavach Gateway", "onAutoForward": "notify" },
    "3084": { "label": "Zolexora TMS Gateway", "onAutoForward": "notify" },
    "3085": { "label": "Future App 1 Gateway", "onAutoForward": "notify" },
    "3086": { "label": "Future App 2 Gateway", "onAutoForward": "notify" },
    "3087": { "label": "Future App 3 Gateway", "onAutoForward": "notify" },
    "3088": { "label": "Future App 4 Gateway", "onAutoForward": "notify" },
    "3089": { "label": "Future App 5 Gateway", "onAutoForward": "notify" },
    "4010": { "label": "The Textile Care API", "onAutoForward": "silent" },
    "4030": { "label": "Zolexora TMS Backend API", "onAutoForward": "silent" },
    "4090": { "label": "Zolexora AI API", "onAutoForward": "silent" },
    "4100": { "label": "Marketplace API (FastAPI)", "onAutoForward": "notify" },
    "4110": { "label": "Future App 1 Backend API", "onAutoForward": "silent" },
    "4120": { "label": "Future App 2 Backend API", "onAutoForward": "silent" },
    "8000": { "label": "Frappe Backend / FastAPI Dev", "onAutoForward": "notify" },
    "8001": { "label": "FastAPI App 2", "onAutoForward": "silent" },
    "8080": { "label": "Zolexora ERP Frontend (Nginx)", "onAutoForward": "openBrowser" },
    "8443": { "label": "Zolexora ERP HTTPS (Nginx)", "onAutoForward": "silent" },
    "5432": { "label": "Host OS PostgreSQL (Ignore)", "onAutoForward": "ignore" },
    "5433": { "label": "Marketplace Postgres", "onAutoForward": "silent" },
    "5434": { "label": "IMS Postgres", "onAutoForward": "silent" },
    "5435": { "label": "The Textile Care Postgres", "onAutoForward": "silent" },
    "5436": { "label": "Rentoeasy Postgres", "onAutoForward": "silent" },
    "5437": { "label": "ClarityFi Postgres", "onAutoForward": "silent" },
    "5438": { "label": "Host Reserved / In-Use", "onAutoForward": "ignore" },
    "5439": { "label": "AppSuite Postgres", "onAutoForward": "silent" },
    "5440": { "label": "Platform Admin Postgres", "onAutoForward": "silent" },
    "5441": { "label": "Future App 1 Postgres", "onAutoForward": "silent" },
    "5442": { "label": "Future App 2 Postgres", "onAutoForward": "silent" },
    "5443": { "label": "Future App 3 Postgres", "onAutoForward": "silent" },
    "5444": { "label": "Future App 4 Postgres", "onAutoForward": "silent" },
    "5445": { "label": "Future App 5 Postgres", "onAutoForward": "silent" },
    "5448": { "label": "Zolexora TMS Postgres", "onAutoForward": "silent" },
    "6379": { "label": "Redis", "onAutoForward": "silent" },
    "27017": { "label": "MongoDB (ZolexoraMarketplace)", "onAutoForward": "silent" },
    "54321": { "label": "Supabase API", "onAutoForward": "silent" },
    "54322": { "label": "Supabase DB", "onAutoForward": "silent" },
    "54323": { "label": "Supabase Studio", "onAutoForward": "notify" },
    "54324": { "label": "Supabase Inbucket", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.black-formatter",
        "charliermarsh.ruff",
        "ms-python.mypy-type-checker",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "dsznajder.es7-react-js-snippets",
        "ms-azuretools.vscode-docker",
        "cweijan.vscode-database-client2",
        "eamodio.gitlens",
        "github.vscode-pull-request-github",
        "humao.rest-client",
        "mathiasfrohlich.kotlin",
        "cloudflare.cloudflare-workers-bindings"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.analysis.extraPaths": [
          "${workspaceFolder}/products/zolexora-erp/backend/frappe",
          "${workspaceFolder}/products/zolexora-erp/backend/erpnext",
          "${workspaceFolder}/products/zolexora-erp/backend/payments",
          "${workspaceFolder}/products/zolexora-erp/backend/zolexora_core",
          "${workspaceFolder}/products/zolexora-erp/backend/zolexora_branding",
          "${workspaceFolder}/products/zolexora-erp/backend/zolexora_platform",
          "${workspaceFolder}/products/zolexora-erp/backend/zolexora_integrations"
        ],
        "python.autoComplete.extraPaths": [
          "${workspaceFolder}/products/zolexora-erp/backend/frappe",
          "${workspaceFolder}/products/zolexora-erp/backend/erpnext",
          "${workspaceFolder}/products/zolexora-erp/backend/payments",
          "${workspaceFolder}/products/zolexora-erp/backend/zolexora_core",
          "${workspaceFolder}/products/zolexora-erp/backend/zolexora_branding",
          "${workspaceFolder}/products/zolexora-erp/backend/zolexora_platform",
          "${workspaceFolder}/products/zolexora-erp/backend/zolexora_integrations"
        ],
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        }
      }
    }
  },
  "postCreateCommand": "bash scripts/dev/setup-devcontainer.sh"
}
