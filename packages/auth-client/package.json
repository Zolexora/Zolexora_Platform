{
  "name": "@zolexora/auth-client",
  "version": "1.0.0",
  "description": "Zolexora Platform Unified Authentication Client SDK for Next.js, React, and Node.js",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs",
      "default": "./dist/react.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs",
      "default": "./dist/client.js"
    },
    "./turnstile": {
      "types": "./dist/turnstile.d.ts",
      "import": "./dist/turnstile.js",
      "require": "./dist/turnstile.cjs",
      "default": "./dist/turnstile.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react.d.ts"
      ],
      "client": [
        "./dist/client.d.ts"
      ],
      "turnstile": [
        "./dist/turnstile.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "firebase": ">=10.0.0 || >=11.0.0 || >=12.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "firebase": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@zolexora/utils": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@zolexora/tsconfig": "workspace:*",
    "happy-dom": "^17.1.8",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^5.0.3"
  }
}
