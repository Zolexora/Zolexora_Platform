FROM node:22-bookworm-slim AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@9.0.0 --activate

FROM base AS builder
WORKDIR /workspace
COPY . .
ARG APP_NAME
RUN pnpm dlx turbo prune ${APP_NAME} --docker

FROM base AS installer
WORKDIR /workspace
COPY --from=builder /workspace/out/json/ .
COPY --from=builder /workspace/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN pnpm config set ignore-scripts true && pnpm install --no-frozen-lockfile

COPY --from=builder /workspace/out/full/ .
COPY turbo.json turbo.json
ARG APP_NAME
RUN pnpm dlx turbo run build --filter=${APP_NAME}

FROM nginx:alpine AS runner
ARG APP_DIR
COPY --from=installer /workspace/${APP_DIR}/build /usr/share/nginx/html
EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://localhost:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
