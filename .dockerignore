# Every Docker build uses the repo root as context (AGENTS.md), so this is the only .dockerignore
# that applies (besides <Dockerfile>.dockerignore files next to shared Dockerfiles).
.git/
**/.git
.github/
.agents/
.pnpm-store/
**/node_modules/
**/.venv/
**/venv/
**/__pycache__
**/*.py[cod]
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.next/
**/.turbo/
**/.vite/
**/dist/
**/build/
**/coverage/
**/*.tsbuildinfo
**/*.swp
**/.env
**/.env.*
**/.gradle/
logs/
assets/
backups/
sites/
storage/
