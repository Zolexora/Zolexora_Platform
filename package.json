{
  "name": "zolexora-platform",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "build": "turbo run build",
    "test": "vitest run platform/",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && pnpm -r exec rm -rf node_modules dist .turbo",
    "dev:suite": "pnpm --filter @zas/client dev:infisical",
    "dev:suite:client": "pnpm --filter @zas/client dev:infisical",
    "dev:suite:team": "pnpm --filter @zas/dev-team dev:infisical",
    "dev:suite:api": "pnpm --filter @zas/backend dev:infisical",
    "dev:tms": "pnpm --filter @zolexora/tms-web dev",
    "dev:tms:infisical": "infisical run --env=dev --path=/Zolexora_Auth_TMS -- pnpm --filter @zolexora/tms-web dev",
    "dev:tms:admin": "pnpm --filter @zolexora/tms-admin dev",
    "dev:tms:admin:infisical": "infisical run --env=dev --path=/Zolexora_Auth_TMS -- pnpm --filter @zolexora/tms-admin dev",
    "dev:tms:api": "PYTHONPATH=products/zolexora-tms/apps/backend products/zolexora-tms/apps/backend/.venv/bin/python -m uvicorn app.main:app --reload --host 127.0.0.1 --port 4030 --app-dir products/zolexora-tms/apps/backend",
    "dev:tms:api:infisical": "infisical run --env=dev --path=/Zolexora_Auth_TMS -- python -m uvicorn app.main:app --reload --host 127.0.0.1 --port 4030 --app-dir products/zolexora-tms/apps/backend",
    "start:tms": "bash products/zolexora-tms/scripts/local-start.sh",
    "docker:tms:start": "bash products/zolexora-tms/scripts/docker-start.sh start",
    "docker:tms:stop": "bash products/zolexora-tms/scripts/docker-start.sh stop",
    "docker:tms:restart": "bash products/zolexora-tms/scripts/docker-start.sh restart",
    "docker:tms:build": "bash products/zolexora-tms/scripts/docker-start.sh build",
    "docker:tms:pull": "bash products/zolexora-tms/scripts/docker-start.sh pull",
    "docker:tms:logs": "bash products/zolexora-tms/scripts/docker-start.sh logs",
    "docker:tms:status": "bash products/zolexora-tms/scripts/docker-start.sh status",
    "dev:ironclub": "pnpm --filter @zolexora/ironclub-admin-web dev",
    "dev:ironclub:admin": "pnpm --filter @zolexora/ironclub-admin-web dev",
    "dev:ironclub:manager": "pnpm --filter @zolexora/ironclub-manager-web dev",
    "dev:ironclub:marketing": "pnpm --filter @zolexora/ironclub-marketing-web dev",
    "dev:ironclub:mobile:manager": "pnpm --filter @zolexora/ironclub-manager-mobile start",
    "dev:ironclub:mobile:member": "pnpm --filter @zolexora/ironclub-member-mobile start",
    "dev:ironclub:api": "products/zolexora-ironclub/apps/backend/.venv/bin/python -m uvicorn app.main:app --reload --host 127.0.0.1 --port 4060 --app-dir products/zolexora-ironclub/apps/backend",
    "build:ironclub": "pnpm --filter \"@zolexora/ironclub-*\" build",
    "start:ironclub": "bash products/zolexora-ironclub/scripts/dev.sh",
    "ecosystem:check": "bash scripts/dev/setup-cli-ecosystem.sh --check",
    "ecosystem:setup": "bash scripts/dev/setup-cli-ecosystem.sh",
    "cli:check": "bash scripts/dev/setup-cli-ecosystem.sh --check",
    "cli:setup": "bash scripts/dev/setup-cli-ecosystem.sh"
  },
  "devDependencies": {
    "turbo": "^2.11.7",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0"
    }
  }
}
