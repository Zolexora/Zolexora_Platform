    "setup:admin:api": "python3 -m venv apps/zolexora-platform-admin/backend/.venv && apps/zolexora-platform-admin/backend/.venv/bin/pip install -q -r apps/zolexora-platform-admin/backend/requirements-dev.txt",
    "dev:admin:api": "bash scripts/setup/with-infisical.sh apps/zolexora-platform-admin apps/zolexora-platform-admin/backend/.venv/bin/uvicorn app.main:app --reload --host 127.0.0.1 --port 4041 --app-dir apps/zolexora-platform-admin/backend",
    "build:admin": "pnpm --filter @zolexora/platform-admin-frontend build",
    "build:admin:frontend": "pnpm --filter @zolexora/platform-admin-frontend build",
    "lint:admin": "pnpm --filter @zolexora/platform-admin-frontend lint",
    "test:admin:api": "cd apps/zolexora-platform-admin/backend && .venv/bin/pytest tests -q",
