FROM node:22-alpine AS builder
RUN corepack enable && corepack prepare pnpm@9 --activate
WORKDIR /app

COPY products/rentoeasy/package.json ./package.json
COPY pnpm-lock.yaml ./pnpm-lock.yaml
COPY products/rentoeasy/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY products/rentoeasy/tsconfig.base.json ./tsconfig.base.json

# Copy rento-easy packages + root shared packages side by side
COPY products/rentoeasy/packages ./packages
COPY packages/api-contracts ./packages/api-contracts
COPY packages/tsconfig ./packages/tsconfig
COPY packages/eslint-config ./packages/eslint-config

# Copy the API service
COPY products/rentoeasy/services/api ./services/api

RUN ln -s /app/packages /packages
RUN pnpm config set ignore-scripts true && pnpm install --no-frozen-lockfile
RUN pnpm --filter @rent-stay/utils build
RUN pnpm --filter @rent-stay/api prisma:generate
RUN pnpm --filter @rent-stay/api build

FROM node:22-alpine
# Prisma's query engine requires libssl 1.1 (not available on Alpine 3.17+ by default)
RUN apk add --no-cache openssl libc6-compat
WORKDIR /app
# Copy the entire workspace so pnpm symlinks (into .pnpm) are intact
COPY --from=builder /app ./
WORKDIR /app/services/api
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
  CMD wget -qO- http://localhost:3000/health || exit 1
CMD ["node", "dist/src/main"]
