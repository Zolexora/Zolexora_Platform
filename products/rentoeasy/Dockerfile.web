ARG APP_DIR=products/rentoeasy/apps/web-tenant
FROM node:22-alpine AS builder
ARG APP_DIR
WORKDIR /app
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages ./packages
COPY products/rentoeasy ./products/rentoeasy
RUN corepack enable && corepack prepare pnpm@10 --activate
RUN ln -s /app/packages /packages
RUN pnpm config set ignore-scripts true && pnpm install --no-frozen-lockfile
RUN pnpm --filter "./${APP_DIR}" build

FROM nginx:alpine
ARG APP_DIR
COPY --from=builder /app/${APP_DIR}/dist /usr/share/nginx/html
EXPOSE 80

