{
  "name": "@zolexora/ims",
  "version": "2.0.0",
  "private": true,
  "description": "Zolexora IMS — inventory and point of sale",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev:user:frontend": "pnpm --filter @zolexora/ims-user-frontend dev",
    "dev:user:backend": "cd services/user-api && uvicorn main:app --reload --port 4050",
    "build": "pnpm --filter \"@zolexora/ims-user-frontend...\" build",
    "test:backend": "cd services/user-api && pytest tests",
    "test:all": "bash scripts/run-all-tests.sh",
    "health": "bash scripts/check-health.sh",
    "docker:up": "bash scripts/docker-start.sh start",
    "docker:down": "bash scripts/docker-start.sh stop",
    "db:status": "bash scripts/db-ops.sh status",
    "db:backup": "bash scripts/db-ops.sh backup",
    "menu": "bash scripts/menu.sh"
  },
  "devDependencies": {
    "wrangler": "^4.129.0"
  }
}
