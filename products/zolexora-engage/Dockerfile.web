FROM node:20-alpine AS builder
RUN corepack enable && corepack prepare pnpm@9 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY artifacts/client/web ./artifacts/client/web
RUN pnpm install --frozen-lockfile
RUN pnpm --filter "@zolexora-engage/web" build

FROM nginx:alpine
COPY --from=builder /app/artifacts/client/web/dist /usr/share/nginx/html
EXPOSE 80
