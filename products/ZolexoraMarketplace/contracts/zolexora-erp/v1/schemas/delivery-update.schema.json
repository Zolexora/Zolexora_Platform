{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "Delivery update", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "tenant_external_id", "organization_external_id", "order_external_id", "delivery_external_id", "status", "occurred_at", "idempotency_key"],
  "properties": {"schema_version": {"const": "1.0"}, "tenant_external_id": {"type": "string", "minLength": 1}, "organization_external_id": {"type": "string", "minLength": 1}, "order_external_id": {"type": "string", "minLength": 1}, "delivery_external_id": {"type": "string", "minLength": 1}, "status": {"enum": ["created", "dispatched", "delivered", "cancelled"]}, "occurred_at": {"type": "string", "format": "date-time", "pattern": "Z$"}, "carrier_reference": {"type": ["string", "null"]}, "idempotency_key": {"type": "string", "minLength": 1}}
}
