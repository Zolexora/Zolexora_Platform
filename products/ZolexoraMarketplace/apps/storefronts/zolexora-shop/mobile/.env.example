# Zolexora Mobile Buyer Environment Variables
# Copy to `.env` for local Expo development.

# [REQUIRED in production] URL of the backend API
# E.g. https://api.zolexora.com/api
# Default for development is http://localhost:8000/api
EXPO_PUBLIC_API_URL=http://localhost:8000/api
EXPO_PUBLIC_STOREFRONT_KEY=zolexora-shop

# [REQUIRED for Google Auth login]
EXPO_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
