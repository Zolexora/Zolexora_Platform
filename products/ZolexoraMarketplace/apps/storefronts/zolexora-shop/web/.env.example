# Zolexora Web Buyer Environment Variables
# Copy to `.env.local` for local development.

# [REQUIRED in production] URL of the backend API
# E.g. https://api.zolexora.com/api
# Default for development is http://localhost:8000/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# [REQUIRED for Google Auth login]
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Firebase Authentication — Zolexora Shop web app
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyC5b3JYtiVFoGfBQ3CtXO2t7yJik9UNNs4
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=zolexoramarketplace.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=zolexoramarketplace
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=zolexoramarketplace.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=663716266535
NEXT_PUBLIC_FIREBASE_APP_ID=1:663716266535:web:0a333a1d89530abb828402

# [REQUIRED for Razorpay modal]
NEXT_PUBLIC_RAZORPAY_KEY=rzp_test_xxxxxxxxxxxx
