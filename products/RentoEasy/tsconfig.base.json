{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@rent-stay/types": ["./packages/shared-types/src/index.ts"],
      "@rent-stay/utils": ["./packages/shared-utils/src/index.ts"],
      "@rent-stay/ui": ["./packages/ui-web/src/index.ts"]
    }
  },
  "exclude": ["node_modules"]
}
