# ═════ Runtime mode / validation controls ══════════════════════════════════════
APP_ENV=development
TESTING=false
SKIP_STARTUP_ENV_VALIDATION=false

# ═════ Canonical Marketplace PostgreSQL ═══════════════════════════════════════
DATABASE_URL=postgresql://marketplace_local:replace-with-local-password@localhost:55432/marketplace_local
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=10
DATABASE_COMMAND_TIMEOUT=30

# ═════ MongoDB Atlas — documents (products, orders, cart, reels, shipping, coins)
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=zolexora_db
DB_NAME=zolexora_db

# ═════ Redis — opaque sessions, OTPs, verification, and cache ════════════════
REDIS_URL=redis://localhost:6379
REDIS_NAMESPACE=zolexora
REDIS_POOL_MAX=20
REDIS_CONNECT_TIMEOUT=2
SESSION_TTL_SECONDS=86400
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
REGISTRATION_RATE_WINDOW_SECONDS=3600
REGISTRATION_RATE_LIMIT=5
AUTH_OTP_PEPPER=replace-with-random-server-only-pepper

# ═════ JWT Authentication & Admin Seed ═════════════════════════════════════════
JWT_SECRET=replace-with-jwt-secret
JWT_EXPIRE_HOURS=24
DEFAULT_ADMIN_EMAIL=admin@example.invalid
DEFAULT_ADMIN_PASSWORD=replace-with-strong-admin-password

# ═════ Firebase Authentication identity token verification ═════════════════════
# No service-account key is required: the API validates Firebase ID tokens against
# Firebase's public signing keys and keeps Marketplace roles/sessions locally.
FIREBASE_PROJECT_ID=zolexoramarketplace

# GSTIN taxpayer verification (ClearTax; keep credentials server-side)
GST_CLEARTAX_BASE_URL=https://api.cleartax.in
GST_CLEARTAX_AUTH_TOKEN=replace-with-cleartax-auth-token
GST_CLEARTAX_TAXABLE_ENTITY_ID=replace-with-cleartax-taxable-entity-id
# Development only; never enable mock mode in production.
GST_LOOKUP_MODE=provider
# Optional development-only fixture; leave blank outside local development.
SELLER_MOCK_VERIFIED_FIREBASE_UID=

# ═════ Supabase Auth / External configuration ═════════════════════════════════
SUPABASE_URL=https://replace-with-your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_DB_PASSWORD=replace-with-db-password

# ═════ Address Validation & Logistics Integrations ════════════════════════════
GOOGLE_ADDRESS_VALIDATION_API_KEY=replace-with-google-address-validation-key
SHIPWAY_API_KEY=replace-with-shipway-api-key
SHIPWAY_BASE_URL=https://app.shipway.com/api

# ═════ SMS Providers (Failover & Fallback) ═════════════════════════════════════
SMS_PROVIDER=mock
SMSCOUNTRY_AUTH_KEY=replace-with-smscountry-auth-key
SMSCOUNTRY_AUTH_TOKEN=replace-with-smscountry-auth-token
SMSCOUNTRY_SENDER_ID=ZOLEXA
SMSCOUNTRY_A1_AUTH_KEY=replace-with-backup-smscountry-auth-key
SMSCOUNTRY_A1_AUTH_TOKEN=replace-with-backup-smscountry-auth-token
SMSCOUNTRY_A1_SENDER_ID=ZOLEXA
MSG91_AUTH_KEY=replace-with-msg91-auth-key
MSG91_TEMPLATE_ID=replace-with-dlt-template-id
FAST2SMS_API_KEY=replace-with-fast2sms-api-key
PHONE_OTP_TTL_SECONDS=300
PHONE_OTP_RESEND_COOLDOWN_SECONDS=60
PHONE_OTP_MAX_HOURLY_LIMIT=5

# ═════ Cloudinary — ALL binary media (images, videos, avatars) ════════════════
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ═════ Cloudflare ═════════════════════════════════════════════════════════════
CLOUDFLARE_API_TOKEN=replace-with-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
CLOUDFLARE_ZONE_ID=replace-with-cloudflare-zone-id

# ═════ Email (Resend) ═════════════════════════════════════════════════════════
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
SENDER_EMAIL=noreply@example.invalid

# ═════ Payment Gateways & Manual UPI ═══════════════════════════════════════════
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-with-razorpay-secret-key
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret
CASHFREE_ENVIRONMENT=SANDBOX
CASHFREE_CLIENT_ID=replace-with-cashfree-client-id
CASHFREE_CLIENT_SECRET=replace-with-cashfree-client-secret
UPI_ID=pay@example.invalid
UPI_MERCHANT_NAME=Zolexora

# ═════ Checkout Quotes & Shipping Webhooks ════════════════════════════════════
CHECKOUT_QUOTE_SIGNING_SECRET=replace-with-quote-signing-secret
CHECKOUT_QUOTE_EXPIRY_MINUTES=15
SHIPPING_WEBHOOK_SECRET=replace-with-random-webhook-secret-key
SHIPROCKET_WEBHOOK_SECRET=replace-with-random-webhook-secret-key

# ═════ CORS & Storefront URLs ═════════════════════════════════════════════════
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002,http://127.0.0.1:3003
ZOLEXORA_SHOP_URL=http://localhost:3000,http://127.0.0.1:3000
MAHILA_MADEL_URL=http://localhost:3003,http://127.0.0.1:3003
SELLER_URL=http://localhost:3001,http://127.0.0.1:3001
ADMIN_URL=http://localhost:3002,http://127.0.0.1:3002

# ═════ Storefront Configuration ═══════════════════════════════════════════════
ZOLEXORA_SHOP_PAYMENT_PROVIDER=razorpay
MAHILA_MADEL_PAYMENT_PROVIDER=cashfree
MAX_CART_QUANTITY=100
