FROM node:26-alpine
WORKDIR /app
COPY products/zolexora-maunkavach/services/backend/package*.json ./
RUN npm install --omit=dev
COPY products/zolexora-maunkavach/services/backend/ .
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
  CMD wget -qO- http://localhost:8080/health || exit 1
CMD ["node", "server.js"]
