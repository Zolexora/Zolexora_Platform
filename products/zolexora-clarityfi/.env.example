# ClarityFi Production Environment Variables

# Node & Runtime
NODE_ENV=production
PORT=8080
CLARITYFI_PORT=3110

# Database (PostgreSQL / Drizzle)
# Provisioned database connection string (if persistence layer is enabled)
# DATABASE_URL=postgresql://user:password@host:5432/clarityfi

# Public URLs & Domain Routing
# CLARITYFI_WEB_URL=https://clarityfi.zolexora.com
# CLARITYFI_API_URL=https://api.clarityfi.zolexora.com
