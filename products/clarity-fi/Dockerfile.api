FROM node:22-alpine AS builder

RUN corepack enable && corepack prepare pnpm@9 --activate
WORKDIR /app

# Copy workspace config
COPY products/clarity-fi/package.json ./package.json
COPY products/clarity-fi/pnpm-lock.yaml ./pnpm-lock.yaml
COPY products/clarity-fi/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY products/clarity-fi/tsconfig.base.json ./tsconfig.base.json
COPY products/clarity-fi/tsconfig.json ./tsconfig.json

# Copy clarity-fi's own packages
COPY products/clarity-fi/packages ./packages

# Inject root shared packages into local packages/ so workspace:* resolves
COPY packages/tsconfig ./packages/tsconfig

# Copy apps
COPY products/clarity-fi/apps/api-server ./apps/api-server

# Install dependencies and build
RUN pnpm config set ignore-scripts true && pnpm install --no-frozen-lockfile
RUN pnpm --filter @clarityfi/api-server build

FROM node:22-alpine
WORKDIR /app
COPY --from=builder /app/apps/api-server/dist ./dist
CMD ["node", "--enable-source-maps", "./dist/index.mjs"]
