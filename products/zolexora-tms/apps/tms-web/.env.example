# ========================================================
# Zolexora TMS Frontend - Environment Configuration
# ========================================================

# Backend API Endpoint
VITE_API_URL=http://localhost:4030

# Dedicated Firebase Project Configuration for TMS Production/Staging
# Project Alias: tms-prod (zx-tms-prod) or stage-logistics (zx-stage-logistics)
VITE_FIREBASE_PROJECT_ID=zx-tms-prod
VITE_FIREBASE_API_KEY=AIzaSyA_TMS_PROD_REPLACE_WITH_KEY
VITE_FIREBASE_AUTH_DOMAIN=zx-tms-prod.firebaseapp.com
VITE_FIREBASE_APP_ID=1:1001001001:web:tms123456789
VITE_FIREBASE_STORAGE_BUCKET=zx-vault-tms.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1001001001

# Cloudflare Turnstile Bot Protection (Optional / Recommended for Phone OTP)
VITE_TURNSTILE_SITE_KEY=
