# =============================================================
# Zolexora TMS — Environment Configuration Template
# Copy to .env and fill in real values. Never commit .env.
# Secrets are injected at runtime via Infisical in production.
# =============================================================

# -------------------------------------------------------------
# Core Application
# -------------------------------------------------------------
NODE_ENV=development
TMS_PORT=3090
TMS_BACKEND_PORT=4031

# -------------------------------------------------------------
# Docker Image Overrides (defaults pull from GHCR)
# -------------------------------------------------------------
TMS_BACKEND_IMAGE=ghcr.io/zolexora/tms-backend:latest
TMS_WEB_IMAGE=ghcr.io/zolexora/tms-web:latest
TMS_ADMIN_IMAGE=ghcr.io/zolexora/tms-admin:latest
TMS_NGINX_IMAGE=ghcr.io/zolexora/tms-nginx:latest

# -------------------------------------------------------------
# Database — Render Postgres (Zolexora TMS)
# Set DATABASE_URL directly OR use individual components below.
# At least one must be set — no local fallback.
# -------------------------------------------------------------
DATABASE_URL=
DATABASE_ZOLEXORA_TMS_HOST=
DATABASE_ZOLEXORA_TMS_PORT=5432
DATABASE_ZOLEXORA_TMS_NAME=
DATABASE_ZOLEXORA_TMS_USER=
DATABASE_ZOLEXORA_TMS_PASSWORD=
DATABASE_ZOLEXORA_TMS_INTERNAL_DATABASE_URL=
DATABASE_ZOLEXORA_TMS_EXTERNAL_DATABASE_URL=

# -------------------------------------------------------------
# Firebase — Backend (Admin SDK / JWT verification)
# -------------------------------------------------------------
FIREBASE_PROJECT_ID=

# Comma-separated allowed Firebase audience project IDs
# e.g. zx-tms-prod,zx-stage-logistics
FIREBASE_ALLOWED_PROJECTS=

# JWT secret for local test tokens (HS256 fallback — dev only)
JWT_SECRET=

# -------------------------------------------------------------
# Firebase — TMS Web Frontend (Client SDK)
# -------------------------------------------------------------
NEXT_PUBLIC_TMS_CLIENT_FIREBASE_API_KEY=
NEXT_PUBLIC_TMS_CLIENT_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_TMS_CLIENT_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_TMS_CLIENT_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_TMS_CLIENT_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_TMS_CLIENT_FIREBASE_APP_ID=

# -------------------------------------------------------------
# Firebase — TMS Admin Frontend (Client SDK)
# -------------------------------------------------------------
NEXT_PUBLIC_TMS_ADMIN_FIREBASE_API_KEY=
NEXT_PUBLIC_TMS_ADMIN_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_TMS_ADMIN_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_TMS_ADMIN_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_TMS_ADMIN_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_TMS_ADMIN_FIREBASE_APP_ID=

# -------------------------------------------------------------
# Portal URLs (injected into frontend at container start)
# -------------------------------------------------------------
NEXT_PUBLIC_TMS_CLIENT_PORTAL_URL=
NEXT_PUBLIC_TMS_ADMIN_PORTAL_URL=

# -------------------------------------------------------------
# Platform Admins
# Comma-separated list of emails granted platform admin access
# -------------------------------------------------------------
PLATFORM_ADMIN_EMAILS=

# -------------------------------------------------------------
# CORS
# Comma-separated list of allowed origins (leave empty in local dev)
# e.g. https://tms.zolexora.com,https://admin.zolexora.com
# -------------------------------------------------------------
CORS_ORIGINS=

# -------------------------------------------------------------
# Supabase (legacy control-plane — being phased out)
# -------------------------------------------------------------
SUPABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend (tms-admin legacy Supabase client)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# -------------------------------------------------------------
# Payment Gateway — Cashfree
# -------------------------------------------------------------
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=TEST

# -------------------------------------------------------------
# Storage — Cloudflare R2
# -------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=zolexora-assets
R2_ENDPOINT_URL=

# -------------------------------------------------------------
# Storage — Cloudinary
# -------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_URL=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -------------------------------------------------------------
# Cache / Queue — Redis
# -------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -------------------------------------------------------------
# MongoDB Atlas (Tenant operational data)
# -------------------------------------------------------------
MONGODB_ATLAS_PROJECT_ID=
MONGODB_ATLAS_PUBLIC_KEY=
MONGODB_ATLAS_PRIVATE_KEY=

# -------------------------------------------------------------
# Email — Resend
# -------------------------------------------------------------
RESEND_API_KEY=

# -------------------------------------------------------------
# Observability — Sentry
# -------------------------------------------------------------
SENTRY_DSN=
