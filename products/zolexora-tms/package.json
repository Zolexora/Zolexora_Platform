{
  "name": "@zolexora/tms-product",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "local:start": "bash scripts/local-start.sh",
    "docker:start": "bash scripts/docker-start.sh start",
    "docker:stop": "bash scripts/docker-start.sh stop",
    "docker:restart": "bash scripts/docker-start.sh restart",
    "build:tms": "pnpm --filter @zolexora/tms-web run build",
    "build:admin": "pnpm --filter @zolexora/tms-admin run build",
    "dev:tms": "pnpm --filter @zolexora/tms-web run dev",
    "dev:tms:infisical": "bash scripts/with-secrets.sh pnpm --filter @zolexora/tms-web run dev",
    "dev:admin": "pnpm --filter @zolexora/tms-admin run dev",
    "dev:admin:infisical": "bash scripts/with-secrets.sh pnpm --filter @zolexora/tms-admin run dev",
    "test:backend": "bash scripts/with-secrets.sh apps/backend/.venv/bin/pytest apps/backend/tests/",
    "cli:check": "bash ../../scripts/dev/setup-cli-ecosystem.sh --check",
    "cli:setup": "bash ../../scripts/dev/setup-cli-ecosystem.sh",
    "cli:docs": "bash ../../scripts/dev/setup-cli-ecosystem.sh --docs",
    "ecosystem:check": "bash ../../scripts/dev/setup-cli-ecosystem.sh --check",
    "ecosystem:setup": "bash ../../scripts/dev/setup-cli-ecosystem.sh",
    "ecosystem:docs": "bash ../../scripts/dev/setup-cli-ecosystem.sh --docs",
    "dev:mobile": "pnpm --filter @zolexora/tms-mobile run dev",
    "dev:mobile:tunnel": "pnpm --filter @zolexora/tms-mobile run dev:tunnel",
    "mobile:android": "pnpm --filter @zolexora/tms-mobile run android",
    "mobile:ios": "pnpm --filter @zolexora/tms-mobile run ios",
    "mobile:typecheck": "pnpm --filter @zolexora/tms-mobile run typecheck"
  },
  "dependencies": {
    "sonner": "^2.0.8"
  },
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "better-sqlite3",
      "node-gyp"
    ]
  }
}
