ARG APP_PATH=apps/tms-web
FROM node:26-alpine AS builder
ARG APP_PATH
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.12.3 --activate

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages ./packages
COPY products/zolexora-tms ./products/zolexora-tms

RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm config set store-dir /root/.local/share/pnpm/store && \
    pnpm config set ignore-scripts true && \
    pnpm install --no-frozen-lockfile

RUN pnpm --filter "@zolexora/utils" build
RUN pnpm --filter "./products/zolexora-tms/${APP_PATH}" build

FROM nginx:alpine
ARG APP_PATH
COPY products/zolexora-tms/nginx-web.conf /etc/nginx/conf.d/default.conf
COPY products/zolexora-tms/docker-entrypoint-env.sh /docker-entrypoint.d/40-env-config.sh
RUN chmod +x /docker-entrypoint.d/40-env-config.sh
COPY --from=builder /app/products/zolexora-tms/${APP_PATH}/dist /usr/share/nginx/html
EXPOSE 80
