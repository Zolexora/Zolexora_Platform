ARG APP_PATH=apps/tms-web
FROM node:22-alpine AS builder
ARG APP_PATH
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9 --activate

COPY products/zolexora-tms/package.json products/zolexora-tms/pnpm-workspace.yaml ./
COPY platform/auth/user-auth-firebase ./platform/auth/user-auth-firebase
COPY products/zolexora-tms/apps ./apps

RUN pnpm config set ignore-scripts true && pnpm install --no-frozen-lockfile
RUN pnpm --filter "./${APP_PATH}" build

FROM nginx:alpine
ARG APP_PATH
COPY products/zolexora-tms/nginx-web.conf /etc/nginx/conf.d/default.conf
COPY products/zolexora-tms/docker-entrypoint-env.sh /docker-entrypoint.d/40-env-config.sh
RUN chmod +x /docker-entrypoint.d/40-env-config.sh
COPY --from=builder /app/${APP_PATH}/dist /usr/share/nginx/html
EXPOSE 80

