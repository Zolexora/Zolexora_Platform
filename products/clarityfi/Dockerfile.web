FROM nginx:alpine

# Remove default configuration and add optimized web configuration
RUN rm -f /etc/nginx/conf.d/default.conf
COPY products/clarityfi/apps/web/nginx.conf /etc/nginx/conf.d/default.conf

# Copy static web files directly into Nginx public directory
COPY products/clarityfi/apps/web /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
  CMD wget -qO- http://localhost:80/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
