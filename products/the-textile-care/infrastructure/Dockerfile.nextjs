ARG APP_PATH=apps/marketplace-web
FROM node:22-alpine AS builder
ARG APP_PATH
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages ./packages
COPY products/the-textile-care ./products/the-textile-care

RUN corepack enable && corepack prepare pnpm@9 --activate
RUN ln -s /app/packages /packages
RUN pnpm config set ignore-scripts true && pnpm install --no-frozen-lockfile
RUN pnpm --filter "./products/the-textile-care/${APP_PATH}" build

FROM node:22-alpine
WORKDIR /app
ARG APP_PATH
COPY --from=builder /app/products/the-textile-care/${APP_PATH}/.next/standalone ./
COPY --from=builder /app/products/the-textile-care/${APP_PATH}/.next/static ./.next/static
COPY --from=builder /app/products/the-textile-care/${APP_PATH}/public ./public
EXPOSE 3000
CMD ["sh", "-c", "node ${APP_PATH}/server.js"]
