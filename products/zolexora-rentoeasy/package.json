{
  "name": "@zolexora/rentoeasy",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter='./**' --filter='!@zolexora/rentoeasy'",
    "dev:web": "turbo run dev --filter='./apps/*'",
    "dev:api": "turbo run dev --filter='./services/api'",
    "build": "turbo run build --filter='./**' --filter='!@zolexora/rentoeasy'",
    "lint": "turbo run lint --filter='./**' --filter='!@zolexora/rentoeasy'",
    "test": "turbo run test --filter='./**' --filter='!@zolexora/rentoeasy'",
    "type-check": "turbo run type-check --filter='./**' --filter='!@zolexora/rentoeasy'",
    "clean": "turbo run clean --filter='./**' --filter='!@zolexora/rentoeasy' && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "dependencies": {
    "@nestjs/common": "11.1.24",
    "@nestjs/core": "11.1.24",
    "@nestjs/platform-express": "11.1.24",
    "@nestjs/platform-socket.io": "11.1.24",
    "@nestjs/websockets": "11.1.24",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@zolexora/tsconfig": "workspace:*",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0"
  },
  "overrides": {
    "@nestjs/common": "11.1.24",
    "@nestjs/core": "11.1.24",
    "rxjs": "7.8.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "uuid": "^11.1.1"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "better-sqlite3",
      "node-gyp"
    ]
  }
}
