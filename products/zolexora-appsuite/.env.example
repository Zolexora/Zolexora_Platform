# ==============================================================================
# Zolexora App Suite — Environment Configuration Template
# Copy to .env: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Ports & Ingress Gateway
# ------------------------------------------------------------------------------
# For Local Dev: Port 3270 (HTTP)
# For Production VM: Port 80 (HTTP) and 443 (HTTPS)
APPSUITE_PORT=3270
APPSUITE_SSL_PORT=3443

# PostgreSQL Host Port Binding (Default: Loopback 127.0.0.1 for VM security)
POSTGRES_BIND_IP=127.0.0.1
POSTGRES_PORT=5470

# ------------------------------------------------------------------------------
# 2. Database Credentials (Internal PostgreSQL Container)
# ------------------------------------------------------------------------------
POSTGRES_USER=appsuite_user
POSTGRES_PASSWORD=replace_with_strong_random_db_password
POSTGRES_DB=appsuite_db

# ------------------------------------------------------------------------------
# 3. Domain & Public Routing (VM Production)
# ------------------------------------------------------------------------------
# Example for VM:
# DOMAIN_ROOT=zolexora.com
# APP_SUITE_CLIENT_URL=https://app.zolexora.com
# APP_SUITE_DEV_TEAM_URL=https://team.zolexora.com
# NEXT_PUBLIC_API_URL=https://api.zolexora.com

# Example for Local Dev (Path-based or Port 3270):
APP_SUITE_CLIENT_URL=http://localhost:3270
APP_SUITE_DEV_TEAM_URL=http://localhost:3270/team
APP_SUITE_AUTH_APP_URL=http://localhost:3270
NEXT_PUBLIC_API_URL=http://localhost:3270/api
NEXT_PUBLIC_DEV_TEAM_URL=http://localhost:3270/team
NEXT_PUBLIC_CLIENT_URL=http://localhost:3270

# ------------------------------------------------------------------------------
# 4. Optional Prebuilt Container Image Overrides
# ------------------------------------------------------------------------------
# APPSUITE_BACKEND_IMAGE=ghcr.io/zolexora/appsuite-backend:latest
# APPSUITE_CLIENT_IMAGE=ghcr.io/zolexora/appsuite-client:latest
# APPSUITE_TEAM_IMAGE=ghcr.io/zolexora/appsuite-team:latest
# APPSUITE_NGINX_IMAGE=ghcr.io/zolexora/appsuite-nginx:latest
