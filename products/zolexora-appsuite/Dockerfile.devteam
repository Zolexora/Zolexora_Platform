FROM node:22-alpine AS builder

RUN corepack enable && corepack prepare pnpm@9 --activate
WORKDIR /app

# Copy monorepo workspace files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.json ./
COPY packages ./packages
COPY platform ./platform
COPY products/zolexora-appsuite ./products/zolexora-appsuite

# Install dependencies and build dev-team with standalone output
RUN pnpm config set ignore-scripts true && pnpm install --no-frozen-lockfile
RUN pnpm --filter @zas/dev-team build

FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production \
    PORT=3071 \
    HOSTNAME="0.0.0.0"

COPY --from=builder /app/products/zolexora-appsuite/apps/dev-team/.next/standalone ./
COPY --from=builder /app/products/zolexora-appsuite/apps/dev-team/.next/static ./products/zolexora-appsuite/apps/dev-team/.next/static

EXPOSE 3071

HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
  CMD wget -qO- http://localhost:3071/ || exit 1

CMD ["node", "products/zolexora-appsuite/apps/dev-team/server.js"]
