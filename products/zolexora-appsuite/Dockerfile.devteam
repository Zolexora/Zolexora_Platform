FROM node:22-alpine AS builder

RUN corepack enable && corepack prepare pnpm@9 --activate
WORKDIR /app

# Copy monorepo workspace files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.json ./
COPY packages ./packages
COPY platform ./platform
COPY products/zolexora-appsuite ./products/zolexora-appsuite

# Install dependencies and build dev-team with standalone output
RUN pnpm config set ignore-scripts true && pnpm install --no-frozen-lockfile

ARG NEXT_PUBLIC_API_URL=http://localhost:3270/api
ARG NEXT_PUBLIC_CLIENT_URL=http://localhost:3270
ARG NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAogbrOXGDbmnUBfgMrMLtIDqT4EijJLZ8
ARG NEXT_PUBLIC_FIREBASE_DEVTEAM_API_KEY=AIzaSyAogbrOXGDbmnUBfgMrMLtIDqT4EijJLZ8
ARG NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=zolexora-authentication.firebaseapp.com
ARG NEXT_PUBLIC_FIREBASE_DEVTEAM_AUTH_DOMAIN=zolexora-authentication.firebaseapp.com
ARG NEXT_PUBLIC_FIREBASE_PROJECT_ID=zolexora-authentication
ARG NEXT_PUBLIC_FIREBASE_DEVTEAM_PROJECT_ID=zolexora-authentication
ARG NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=zolexora-authentication.firebasestorage.app
ARG NEXT_PUBLIC_FIREBASE_DEVTEAM_STORAGE_BUCKET=zolexora-authentication.firebasestorage.app
ARG NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=743211765178
ARG NEXT_PUBLIC_FIREBASE_DEVTEAM_MESSAGING_SENDER_ID=743211765178
ARG NEXT_PUBLIC_FIREBASE_APP_ID=1:743211765178:web:3e37eaa0eb22ece203a183
ARG NEXT_PUBLIC_FIREBASE_DEVTEAM_APP_ID=1:743211765178:web:3e37eaa0eb22ece203a183
ARG NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-5QF3P8FMMW
ARG NEXT_PUBLIC_FIREBASE_DEVTEAM_MEASUREMENT_ID=G-5QF3P8FMMW

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_CLIENT_URL=$NEXT_PUBLIC_CLIENT_URL \
    NEXT_PUBLIC_FIREBASE_API_KEY=$NEXT_PUBLIC_FIREBASE_API_KEY \
    NEXT_PUBLIC_FIREBASE_DEVTEAM_API_KEY=$NEXT_PUBLIC_FIREBASE_DEVTEAM_API_KEY \
    NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=$NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN \
    NEXT_PUBLIC_FIREBASE_DEVTEAM_AUTH_DOMAIN=$NEXT_PUBLIC_FIREBASE_DEVTEAM_AUTH_DOMAIN \
    NEXT_PUBLIC_FIREBASE_PROJECT_ID=$NEXT_PUBLIC_FIREBASE_PROJECT_ID \
    NEXT_PUBLIC_FIREBASE_DEVTEAM_PROJECT_ID=$NEXT_PUBLIC_FIREBASE_DEVTEAM_PROJECT_ID \
    NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=$NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET \
    NEXT_PUBLIC_FIREBASE_DEVTEAM_STORAGE_BUCKET=$NEXT_PUBLIC_FIREBASE_DEVTEAM_STORAGE_BUCKET \
    NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=$NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID \
    NEXT_PUBLIC_FIREBASE_DEVTEAM_MESSAGING_SENDER_ID=$NEXT_PUBLIC_FIREBASE_DEVTEAM_MESSAGING_SENDER_ID \
    NEXT_PUBLIC_FIREBASE_APP_ID=$NEXT_PUBLIC_FIREBASE_APP_ID \
    NEXT_PUBLIC_FIREBASE_DEVTEAM_APP_ID=$NEXT_PUBLIC_FIREBASE_DEVTEAM_APP_ID \
    NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=$NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID \
    NEXT_PUBLIC_FIREBASE_DEVTEAM_MEASUREMENT_ID=$NEXT_PUBLIC_FIREBASE_DEVTEAM_MEASUREMENT_ID

RUN pnpm --filter @zas/dev-team build

FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production \
    PORT=3071 \
    HOSTNAME="0.0.0.0"

COPY --from=builder /app/products/zolexora-appsuite/apps/dev-team/.next/standalone ./
COPY --from=builder /app/products/zolexora-appsuite/apps/dev-team/.next/static ./products/zolexora-appsuite/apps/dev-team/.next/static
COPY --from=builder /app/products/zolexora-appsuite/apps/dev-team/public ./products/zolexora-appsuite/apps/dev-team/public

EXPOSE 3071

HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:${PORT:-3071}/login || exit 1

CMD ["node", "products/zolexora-appsuite/apps/dev-team/server.js"]
