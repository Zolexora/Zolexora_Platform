{
  "name": "zolexora-app-suite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @zas/web dev",
    "dev:infisical": "pnpm --filter @zas/web dev:infisical",
    "dev:team": "pnpm --filter @zas/dev-team dev",
    "dev:team:infisical": "pnpm --filter @zas/dev-team dev:infisical",
    "build": "pnpm --filter @zas/web build && pnpm --filter @zas/dev-team build",
    "start": "pnpm --filter @zas/web start",
    "lint": "pnpm --filter @zas/web lint && pnpm --filter @zas/dev-team lint",
    "type-check": "pnpm --filter @zas/web type-check && pnpm --filter @zas/dev-team type-check"
  }
}
