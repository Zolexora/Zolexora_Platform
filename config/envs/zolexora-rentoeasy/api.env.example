# ─── SERVER ───────────────────────────────────────────────────────────────────
PORT=4020
NODE_ENV=development

# ─── DATABASE ─────────────────────────────────────────────────────────────────
# Pooler URL  — port 6543 (runtime + Codespaces)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"
# Direct URL — port 5432 (prisma migrate dev — local only)
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# ─── REDIS ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your_access_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_here_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# ─── ALLOWED ORIGINS ──────────────────────────────────────────────────────────
TENANT_WEB_URL=http://localhost:3001,http://127.0.0.1:3001
OWNER_WEB_URL=http://localhost:3002,http://127.0.0.1:3002
ADMIN_WEB_URL=http://localhost:3003,http://127.0.0.1:3003

# ─── MSG91 (SMS OTP) ──────────────────────────────────────────────────────────
MSG91_AUTH_KEY=your_msg91_key
MSG91_SENDER_ID=RSTAAY
MSG91_OTP_TEMPLATE_ID=your_template_id
MSG91_WHATSAPP_TEMPLATE=your_whatsapp_template

# ─── RAZORPAY ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
PLATFORM_FEE_PERCENT=2

# ─── AWS S3 ───────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_S3_BUCKET=rent-and-stay-uploads
AWS_CLOUDFRONT_URL=https://cdn.rentandstay.in

# ─── CLOUDINARY ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── GOOGLE MAPS ──────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_key

# ─── FIREBASE (FCM + Google Login) ────────────────────────────────────────────
FIREBASE_PROJECT_ID=rent-and-stay
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@rent-and-stay.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── SENDGRID ─────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.your_key
SENDGRID_FROM_EMAIL=noreply@rentandstay.in

# ─── ADMIN SEED ───────────────────────────────────────────────────────────────
ADMIN_SEED_EMAIL=admin@rentandstay.in
ADMIN_SEED_PASSWORD=Admin@12345
ADMIN_SEED_PHONE=9999999999
