# ══════════════════════════════════════════════════════════════════════════
# ZOLEXORA PLATFORM — MASTER DATABASE CREDENTIALS (.env.example)
# 
# IMPORTANT: DO NOT COMMIT REAL VALUES HERE!
# Load this template into Infisical once under /platform-admin.
# All products will fetch their respective keys dynamically at runtime.
# ══════════════════════════════════════════════════════════════════════════

# ── Supabase Project 1: Core ──────────────────────────────────────────────
# Products: Zolexora IMS, Zolexora Marketplace, Zolexora TMS
# Account: <Core Account Email>, Project: zolexora-core
SUPABASE_CORE_URL="https://xxx.supabase.co"
SUPABASE_CORE_ANON_KEY="eyJ..."
SUPABASE_CORE_SERVICE_KEY="eyJ..."

# ── Supabase Project 2: Commerce ──────────────────────────────────────────
# Products: Textile Care, Rento Easy, Platform Admin
# Account: <Commerce Account Email>, Project: zolexora-commerce
SUPABASE_COMMERCE_URL="https://xxx.supabase.co"
SUPABASE_COMMERCE_ANON_KEY="eyJ..."
SUPABASE_COMMERCE_SERVICE_KEY="eyJ..."

# ── Supabase Project 3: Business ──────────────────────────────────────────
# Products: Zolexora Engage, Clarity FI, Maun Kavach
# Account: <Business Account Email>, Project: zolexora-business
SUPABASE_BUSINESS_URL="https://xxx.supabase.co"
SUPABASE_BUSINESS_ANON_KEY="eyJ..."
SUPABASE_BUSINESS_SERVICE_KEY="eyJ..."

# ── Supabase Project 4: AI & ERP ──────────────────────────────────────────
# Products: Zolexora AI, ERP supplements
# Account: <AI ERP Account Email>, Project: zolexora-ai-erp
SUPABASE_AI_ERP_URL="https://xxx.supabase.co"
SUPABASE_AI_ERP_ANON_KEY="eyJ..."
SUPABASE_AI_ERP_SERVICE_KEY="eyJ..."

# ── MongoDB Atlas ─────────────────────────────────────────────────────────
# One free M0 cluster. All product databases live inside it.
MONGO_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"

# ── Cloudflare D1 (Edge Cache) ────────────────────────────────────────────
# These are D1 Database IDs from the Cloudflare Dashboard
CF_ACCOUNT_ID="your_cloudflare_account_id"
CF_API_TOKEN="your_cloudflare_api_token"
D1_SESSIONS_ID="xxxxx-xxxx-xxxx-xxxx-xxxxx"
D1_CATALOG_ID="xxxxx-xxxx-xxxx-xxxx-xxxxx"
D1_CONFIG_ID="xxxxx-xxxx-xxxx-xxxx-xxxxx"
D1_ROUTES_ID="xxxxx-xxxx-xxxx-xxxx-xxxxx"

# ── Cloudflare R2 (File Storage) ──────────────────────────────────────────
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_aws_access_key_id"
R2_SECRET_ACCESS_KEY="your_aws_secret_access_key"
R2_BUCKET_IMS="zolexora-ims-files"
R2_BUCKET_MARKETPLACE="zolexora-marketplace-files"
R2_BUCKET_TMS="zolexora-tms-files"

# ── Shared Services ───────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
